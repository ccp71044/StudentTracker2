<UserControl x:Class="StudentTracker.Wpf.Views.AllocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="AllocationsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Allocations" AutomationProperties.AutomationId="AllocationsHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1">
            <Button Content="Add Allocation" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddAllocationCommand}" AutomationProperties.AutomationId="AddAllocationButton" ToolTip="Create a new allocation" />
            <Button Content="Edit" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditAllocationCommand}" AutomationProperties.AutomationId="EditAllocationButton" ToolTip="Edit the selected allocation" />
            <Button Content="Mark Attendance" Style="{StaticResource ActionButtonStyle}" Command="{Binding MarkAttendanceCommand}" AutomationProperties.AutomationId="MarkAttendanceButton" ToolTip="Mark attendance for the selected allocation" />
            <Button Content="Mark Outcome" Style="{StaticResource ActionButtonStyle}" Command="{Binding MarkOutcomeCommand}" AutomationProperties.AutomationId="MarkOutcomeButton" ToolTip="Mark outcome for the selected allocation" />
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0" />
            <Button Content="Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshAllocationsButton" />
        </StackPanel>
        <DataGrid x:Name="AllocationsDataGrid" ItemsSource="{Binding Allocations}" SelectedItem="{Binding SelectedAllocation}" AutoGenerateColumns="False" Grid.Row="2" Margin="10" IsReadOnly="True"
                 MouseDoubleClick="DataGrid_MouseDoubleClick"
                 PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Edit" Command="{Binding EditAllocationCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_Edit" />
                    <MenuItem Header="Mark Attendance" Command="{Binding MarkAttendanceCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_MarkAttendance" />
                    <MenuItem Header="Mark Outcome" Command="{Binding MarkOutcomeCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_MarkOutcome" />
                    <Separator />
                    <MenuItem Header="Add Placeholder" Command="{Binding AddPlaceholderCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_AddPlaceholder" />
                    <MenuItem Header="Replace Placeholder" Command="{Binding ReplacePlaceholderCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_ReplacePlaceholder" />
                    <MenuItem Header="Carry Forward Placeholder" Command="{Binding CarryForwardPlaceholderCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_CarryForward" />
                    <MenuItem Header="Transfer Allocation" Command="{Binding TransferAllocationCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_Transfer" />
                    <MenuItem Header="Cancel Allocation" Command="{Binding CancelAllocationCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_Cancel" />
                    <Separator />
                    <MenuItem Header="Create/Restore Commitment" Command="{Binding CreateOrRestoreCommitmentCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_CreateCommitment" />
                    <MenuItem Header="Release Commitment" Command="{Binding ReleaseCommitmentCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_ReleaseCommitment" />
                    <MenuItem Header="Mark Cost Spent" Command="{Binding MarkCostSpentCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_MarkCostSpent" />
                    <MenuItem Header="Reverse Spent Cost" Command="{Binding ReverseSpentCostCommand}" AutomationProperties.AutomationId="AllocationsContextMenu_ReverseSpentCost" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Allocation ID" Binding="{Binding DisplayId}" Width="100" />
                <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                <DataGridTextColumn Header="Delivery" Binding="{Binding CourseDelivery.DisplayId}" Width="100" />
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AllocationStatus}" ToolTip="{Binding AllocationStatus, Converter={StaticResource EnumDescriptionConverter}}" Padding="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeStatus}" Width="120" />
                <DataGridTemplateColumn Header="Credit Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CreditStatus}" ToolTip="{Binding CreditStatus, Converter={StaticResource EnumDescriptionConverter}}" Padding="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Budget Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CashCommitmentStatus}" ToolTip="{Binding CashCommitmentStatus, Converter={StaticResource EnumDescriptionConverter}}" Padding="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
