<UserControl x:Class="StudentTracker.Wpf.Views.AllocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="AllocationsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Allocations" AutomationProperties.AutomationId="AllocationsHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1">
            <Button Content="Add Allocation" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddAllocationCommand}" />
            <Button Content="Add Placeholder" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddPlaceholderCommand}" />
            <Button Content="Edit" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditAllocationCommand}" />
            <Button Content="Replace Placeholder" Style="{StaticResource ActionButtonStyle}" Command="{Binding ReplacePlaceholderCommand}" />
            <Button Content="Transfer" Style="{StaticResource ActionButtonStyle}" Command="{Binding TransferAllocationCommand}" ToolTip="Transfer selected allocation to another student or delivery" />
            <Button Content="Mark Attendance" Style="{StaticResource ActionButtonStyle}" Command="{Binding MarkAttendanceCommand}" ToolTip="Mark attendance for selected allocation" />
            <Button Content="Mark Outcome" Style="{StaticResource ActionButtonStyle}" Command="{Binding MarkOutcomeCommand}" ToolTip="Mark outcome for selected allocation" />
            <Button Content="Cancel Allocation" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelAllocationCommand}" />
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,0" />
            <Button Content="Create/Restore Commitment" Style="{StaticResource ActionButtonStyle}" Command="{Binding CreateOrRestoreCommitmentCommand}" ToolTip="Reserve budget for the selected allocation" />
            <Button Content="Release Commitment" Style="{StaticResource ActionButtonStyle}" Command="{Binding ReleaseCommitmentCommand}" ToolTip="Release reserved budget for the selected allocation" />
            <Button Content="Mark Cost Spent" Style="{StaticResource ActionButtonStyle}" Command="{Binding MarkCostSpentCommand}" ToolTip="Mark the reserved cost as spent" />
            <Button Content="Reverse Spent Cost" Style="{StaticResource ActionButtonStyle}" Command="{Binding ReverseSpentCostCommand}" ToolTip="Reverse a spent cost and return it to released" />
            <Button Content="Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" />
        </StackPanel>
        <DataGrid x:Name="AllocationsDataGrid" ItemsSource="{Binding Allocations}" SelectedItem="{Binding SelectedAllocation}" AutoGenerateColumns="False" Grid.Row="2" Margin="10" IsReadOnly="True"
                 MouseDoubleClick="DataGrid_MouseDoubleClick"
                 PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Add Placeholder" Command="{Binding AddPlaceholderCommand}" />
                    <MenuItem Header="Replace Placeholder" Command="{Binding ReplacePlaceholderCommand}" />
                    <MenuItem Header="Transfer Allocation" Command="{Binding TransferAllocationCommand}" />
                    <Separator />
                    <MenuItem Header="Edit" Command="{Binding EditAllocationCommand}" />
                    <MenuItem Header="Mark Attendance" Command="{Binding MarkAttendanceCommand}" />
                    <MenuItem Header="Mark Outcome" Command="{Binding MarkOutcomeCommand}" />
                    <MenuItem Header="Cancel Allocation" Command="{Binding CancelAllocationCommand}" />
                    <Separator />
                    <MenuItem Header="Create/Restore Commitment" Command="{Binding CreateOrRestoreCommitmentCommand}" />
                    <MenuItem Header="Release Commitment" Command="{Binding ReleaseCommitmentCommand}" />
                    <MenuItem Header="Mark Cost Spent" Command="{Binding MarkCostSpentCommand}" />
                    <MenuItem Header="Reverse Spent Cost" Command="{Binding ReverseSpentCostCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Allocation ID" Binding="{Binding DisplayId}" Width="100" />
                <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                <DataGridTextColumn Header="Delivery" Binding="{Binding CourseDelivery.DisplayId}" Width="100" />
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AllocationStatus}" ToolTip="{Binding AllocationStatus, Converter={StaticResource EnumDescriptionConverter}}" Padding="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeStatus}" Width="120" />
                <DataGridTemplateColumn Header="Credit Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CreditStatus}" ToolTip="{Binding CreditStatus, Converter={StaticResource EnumDescriptionConverter}}" Padding="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Budget Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CashCommitmentStatus}" ToolTip="{Binding CashCommitmentStatus, Converter={StaticResource EnumDescriptionConverter}}" Padding="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
