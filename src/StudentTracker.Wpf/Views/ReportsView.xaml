<UserControl x:Class="StudentTracker.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="ReportsView">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedReports" Source="{Binding Reports}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Reports" AutomationProperties.AutomationId="ReportsHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />

        <!-- Toolbar: filters and grouped export menu -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Menu VerticalAlignment="Center" AutomationProperties.AutomationId="ReportsExportMenu">
                    <MenuItem Header="_Export Report" Padding="12,6">
                        <MenuItem Header="_Students" AutomationProperties.AutomationId="ReportsExportMenu_StudentsCategory">
                            <MenuItem Header="_Completed Students" Command="{Binding ExportCompletedCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCompletedCsv" />
                            <MenuItem Header="Awaiting _Order" Command="{Binding ExportAwaitingOrderCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportAwaitingOrderCsv" />
                            <MenuItem Header="_Withdrawn Students" Command="{Binding ExportWithdrawnCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportWithdrawnCsv" />
                            <MenuItem Header="_Non-Completions" Command="{Binding ExportNonCompletionsCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportNonCompletionsCsv" />
                        </MenuItem>
                        <MenuItem Header="_Certificates" AutomationProperties.AutomationId="ReportsExportMenu_CertificatesCategory">
                            <MenuItem Header="Awaiting _Delivery" Command="{Binding ExportAwaitingDeliveryCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportAwaitingDeliveryCsv" />
                            <MenuItem Header="_Delivered" Command="{Binding ExportDeliveredCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportDeliveredCsv" />
                        </MenuItem>
                        <MenuItem Header="_Deliveries" AutomationProperties.AutomationId="ReportsExportMenu_DeliveriesCategory">
                            <MenuItem Header="_Upcoming" Command="{Binding ExportUpcomingDeliveriesCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportUpcomingCsv" />
                            <MenuItem Header="_Cancelled" Command="{Binding ExportCancelledDeliveriesCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCancelledDeliveriesCsv" />
                            <MenuItem Header="_Completed" Command="{Binding ExportCompletedDeliveriesCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCompletedDeliveriesCsv" />
                            <MenuItem Header="Ca_pacity" Command="{Binding ExportCapacityCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCapacityCsv" />
                        </MenuItem>
                        <MenuItem Header="_Allocations" AutomationProperties.AutomationId="ReportsExportMenu_AllocationsCategory">
                            <MenuItem Header="_Active" Command="{Binding ExportActiveAllocationsCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportActiveAllocationsCsv" />
                            <MenuItem Header="_Transferred" Command="{Binding ExportTransferredAllocationsCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportTransferredAllocationsCsv" />
                            <MenuItem Header="_Cancelled" Command="{Binding ExportCancelledAllocationsCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCancelledAllocationsCsv" />
                            <MenuItem Header="_Placeholders" Command="{Binding ExportPlaceholderAllocationsCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportPlaceholderAllocationsCsv" />
                            <MenuItem Header="_Attendance" Command="{Binding ExportAttendanceCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportAttendanceCsv" />
                            <MenuItem Header="Course _Utilization" Command="{Binding ExportCourseUtilizationCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCourseUtilizationCsv" />
                        </MenuItem>
                        <MenuItem Header="_Financial" AutomationProperties.AutomationId="ReportsExportMenu_FinancialCategory">
                            <MenuItem Header="Budget _Summary" Command="{Binding ExportBudgetSummaryCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportBudgetSummaryCsv" />
                            <MenuItem Header="Budget _History" Command="{Binding ExportBudgetHistoryCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportBudgetHistoryCsv" />
                            <MenuItem Header="Credit S_ummary" Command="{Binding ExportCreditSummaryCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCreditSummaryCsv" />
                            <MenuItem Header="Credit _History" Command="{Binding ExportCreditHistoryCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCreditHistoryCsv" />
                            <MenuItem Header="_Prepaid Position" Command="{Binding ExportPrepaidPositionCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportPrepaidPositionCsv" />
                        </MenuItem>
                        <MenuItem Header="_Administration" AutomationProperties.AutomationId="ReportsExportMenu_AdministrationCategory">
                            <MenuItem Header="_Audit Activity" Command="{Binding ExportAuditActivityCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportAuditActivityCsv" />
                            <MenuItem Header="_Import Review Queue" Command="{Binding ExportImportReviewQueueCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportImportReviewQueueCsv" />
                            <MenuItem Header="Certificate _Orders" Command="{Binding ExportCertificateOrdersCsvCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportCertificateOrdersCsv" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Invoice Manager _Cost Position" Command="{Binding ExportInvoiceManagerCostPositionCommand}" AutomationProperties.AutomationId="ReportsExportMenu_ExportInvoiceManagerCostPosition" />
                    </MenuItem>
                </Menu>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="12,0" />

                <CheckBox Content="Replacements only" IsChecked="{Binding ReplacementsOnly}" VerticalAlignment="Center" Margin="8,0" AutomationProperties.AutomationId="ReportsReplacementsOnlyCheckBox" />
                <TextBlock Text="From" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="120" AutomationProperties.AutomationId="ReportsFromDatePicker" />
                <TextBlock Text="To" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="120" AutomationProperties.AutomationId="ReportsToDatePicker" />
                <CheckBox Content="Include archived students" IsChecked="{Binding IncludeArchived}" VerticalAlignment="Center" Margin="10,0" AutomationProperties.AutomationId="ReportsIncludeArchivedCheckBox" />

                <Button Content="Apply / Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="ReportsRefreshButton" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Report selector -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,10,0">
                <ListBox x:Name="ReportsListBox"
                         ItemsSource="{Binding Source={StaticResource GroupedReports}}"
                         SelectedItem="{Binding SelectedReport}"
                         BorderThickness="0"
                         Background="Transparent"
                         AutomationProperties.AutomationId="ReportsListBox">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="4,8,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Report content area -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                <Grid>
                    <!-- Completed Students -->
                    <DataGrid ItemsSource="{Binding CompletedStudents}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="CompletedStudentsReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CompletedStudents">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                            <DataGridTextColumn Header="Course" Binding="{Binding CourseDelivery.CourseDefinition.CourseCode}" Width="120" />
                            <DataGridTextColumn Header="Outcome Date" Binding="{Binding OutcomeDate, StringFormat=dd/MM/yyyy}" Width="120" />
                            <DataGridTextColumn Header="Certificate Cost" Binding="{Binding CertificateCost, StringFormat=C}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Awaiting Certificate Order -->
                    <DataGrid ItemsSource="{Binding AwaitingOrder}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="AwaitingOrderReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="AwaitingOrder">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Withdrawn Students -->
                    <StackPanel AutomationProperties.AutomationId="WithdrawnStudentsReportPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="WithdrawnStudents">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <CheckBox Content="Include costs (cash commitment spent)" IsChecked="{Binding IncludeCostsInWithdrawn}" Margin="0,0,0,10" AutomationProperties.AutomationId="ReportsIncludeCostsInWithdrawnCheckBox" />
                        <DataGrid ItemsSource="{Binding WithdrawnStudents}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                                <DataGridTextColumn Header="Course" Binding="{Binding CourseDelivery.CourseDefinition.CourseCode}" Width="120" />
                                <DataGridTextColumn Header="Outcome Date" Binding="{Binding OutcomeDate, StringFormat=dd/MM/yyyy}" Width="120" />
                                <DataGridTextColumn Header="Certificate Cost" Binding="{Binding CertificateCost, StringFormat=C}" Width="120" />
                                <DataGridTextColumn Header="Cash Status" Binding="{Binding CashCommitmentStatus}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Non-Completions -->
                    <DataGrid ItemsSource="{Binding NonCompletions}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="NonCompletionsReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="NonCompletions">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                            <DataGridTextColumn Header="Course" Binding="{Binding CourseDelivery.CourseDefinition.CourseCode}" Width="120" />
                            <DataGridTextColumn Header="Outcome Date" Binding="{Binding OutcomeDate, StringFormat=dd/MM/yyyy}" Width="120" />
                            <DataGridTextColumn Header="Outcome Status" Binding="{Binding OutcomeStatus}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Awaiting Delivery -->
                    <DataGrid ItemsSource="{Binding AwaitingDelivery}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="AwaitingDeliveryReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="AwaitingDelivery">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                            <DataGridTextColumn Header="Course" Binding="{Binding CourseDelivery.CourseDefinition.CourseCode}" Width="120" />
                            <DataGridTextColumn Header="Outcome Date" Binding="{Binding OutcomeDate, StringFormat=dd/MM/yyyy}" Width="120" />
                            <DataGridTextColumn Header="Order Status" Binding="{Binding CertificateOrderStatus}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Certificates Delivered -->
                    <DataGrid ItemsSource="{Binding CertificatesDelivered}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="CertificatesDeliveredReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CertificatesDelivered">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                            <DataGridTextColumn Header="Course" Binding="{Binding CourseDelivery.CourseDefinition.CourseCode}" Width="120" />
                            <DataGridTextColumn Header="Delivery Date" Binding="{Binding BillableDate, StringFormat=dd/MM/yyyy}" Width="120" />
                            <DataGridTextColumn Header="Certificate Cost" Binding="{Binding CertificateCost, StringFormat=C}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Upcoming Deliveries -->
                    <DataGrid ItemsSource="{Binding UpcomingDeliveries}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="UpcomingDeliveriesReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="UpcomingDeliveries">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Cancelled Deliveries -->
                    <DataGrid ItemsSource="{Binding CancelledDeliveries}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CancelledDeliveriesReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CancelledDeliveries">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Completed Deliveries -->
                    <DataGrid ItemsSource="{Binding CompletedDeliveries}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CompletedDeliveriesReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CompletedDeliveries">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Capacity -->
                    <DataGrid ItemsSource="{Binding CapacityReport}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CapacityReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CapacityReport">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Active Allocations -->
                    <DataGrid ItemsSource="{Binding ActiveAllocations}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="ActiveAllocationsReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="ActiveAllocations">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Transferred Allocations -->
                    <DataGrid ItemsSource="{Binding TransferredAllocations}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="TransferredAllocationsReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="TransferredAllocations">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Cancelled Allocations -->
                    <DataGrid ItemsSource="{Binding CancelledAllocations}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CancelledAllocationsReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CancelledAllocations">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Placeholder Allocations -->
                    <DataGrid ItemsSource="{Binding PlaceholderAllocations}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="PlaceholderAllocationsReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="PlaceholderAllocations">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Attendance -->
                    <DataGrid ItemsSource="{Binding Attendance}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="AttendanceReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="Attendance">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Course Utilization -->
                    <DataGrid ItemsSource="{Binding CourseUtilization}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CourseUtilizationReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CourseUtilization">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Budget Summary -->
                    <DataGrid ItemsSource="{Binding BudgetSummary}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="BudgetSummaryReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="BudgetSummary">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Budget History -->
                    <DataGrid ItemsSource="{Binding BudgetHistory}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="BudgetHistoryReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="BudgetHistory">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Credit Summary -->
                    <DataGrid ItemsSource="{Binding CreditSummary}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CreditSummaryReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CreditSummary">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Credit History -->
                    <DataGrid ItemsSource="{Binding CreditHistory}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CreditHistoryReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CreditHistory">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Audit Activity -->
                    <DataGrid ItemsSource="{Binding AuditActivity}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="AuditActivityReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="AuditActivity">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Import Review Queue -->
                    <DataGrid ItemsSource="{Binding ImportReviewQueue}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="ImportReviewQueueReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="ImportReviewQueue">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Certificate Orders -->
                    <DataGrid ItemsSource="{Binding CertificateOrders}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.AutomationId="CertificateOrdersReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="CertificateOrders">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Prepaid Position -->
                    <DataGrid ItemsSource="{Binding PrepaidPosition}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="PrepaidPositionReportGrid">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReport.Key}" Value="PrepaidPosition">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pool" Binding="{Binding PoolName}" Width="140" />
                            <DataGridTextColumn Header="Course" Binding="{Binding CourseCode}" Width="80" />
                            <DataGridTextColumn Header="Title" Binding="{Binding CourseTitle}" Width="180" />
                            <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryDisplayId}" Width="100" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DeliveryDate, StringFormat=dd/MM/yyyy}" Width="90" />
                            <DataGridTextColumn Header="Funds" Binding="{Binding FundsAdded, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="Committed" Binding="{Binding Committed, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="Spent" Binding="{Binding Spent, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="Available" Binding="{Binding Available, StringFormat=C}" Width="90" />
                            <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedPlaces}" Width="70" />
                            <DataGridTextColumn Header="Pending" Binding="{Binding AssignedPending}" Width="70" />
                            <DataGridTextColumn Header="Awaiting Spend" Binding="{Binding CompletedAwaitingSpend}" Width="100" />
                            <DataGridTextColumn Header="Remaining" Binding="{Binding CompletionsRemaining}" Width="80" />
                            <DataGridTextColumn Header="To Bill" Binding="{Binding BillableUnexported}" Width="70" />
                            <DataGridTextColumn Header="Allen Cost" Binding="{Binding AllenCost, StringFormat=C}" Width="90" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_Export CSV" Command="{Binding ExportPrepaidPositionCsvCommand}" AutomationProperties.AutomationId="PrepaidPositionContextMenu_ExportCsv" />
                                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="PrepaidPositionContextMenu_Refresh" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
