<UserControl x:Class="StudentTracker.Wpf.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="CoursesView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Course Definitions" AutomationProperties.AutomationId="CoursesHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1">
            <Button Content="Add Course" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddCourseCommand}" />
            <Button Content="Edit" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditCourseCommand}" />
            <Button Content="Archive" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeleteCourseCommand}" ToolTip="Deactivate the selected course." />
            <Button Content="Restore" Style="{StaticResource ActionButtonStyle}" Command="{Binding RestoreCourseCommand}" />
            <CheckBox Content="Show inactive" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" Margin="10,0" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" AutoGenerateColumns="False" Grid.Row="2" Margin="10" IsReadOnly="True" 
                 MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding CourseCode}" Width="120" />
                <DataGridTextColumn Header="Title" Binding="{Binding CourseTitle}" Width="300" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                <DataGridTextColumn Header="Duration (days)" Binding="{Binding CourseDurationDays}" Width="110" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
