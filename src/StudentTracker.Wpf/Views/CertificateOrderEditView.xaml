<UserControl x:Class="StudentTracker.Wpf.Views.CertificateOrderEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="500" MinHeight="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Allocation Selection -->
                <TextBlock Text="Allocation:" VerticalAlignment="Center" Margin="0,4" Grid.Row="0" Grid.Column="0" />
                <ComboBox ItemsSource="{Binding AvailableAllocations}" SelectedItem="{Binding SelectedAllocation}" 
                         Grid.Row="0" Grid.Column="1" Margin="8,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} - {1} ({2})">
                                        <Binding Path="DisplayId" />
                                        <Binding Path="Student.FullName" />
                                        <Binding Path="CourseDelivery.CourseDefinition.CourseCode" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Provider -->
                <TextBlock Text="Provider:" VerticalAlignment="Center" Margin="0,4" Grid.Row="1" Grid.Column="0" />
                <TextBox Text="{Binding Provider}" Grid.Row="1" Grid.Column="1" Margin="8,4" />

                <!-- External Reference -->
                <TextBlock Text="External reference:" VerticalAlignment="Center" Margin="0,4" Grid.Row="2" Grid.Column="0" />
                <TextBox Text="{Binding ExternalReference}" Grid.Row="2" Grid.Column="1" Margin="8,4" />

                <!-- Replacement -->
                <CheckBox IsChecked="{Binding IsReplacement}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                         Margin="0,8" Content="This is a replacement order" />

                <!-- Replacement Reason -->
                <TextBlock Text="Replacement reason:" VerticalAlignment="Top" Margin="0,4" Grid.Row="4" Grid.Column="0" />
                <TextBox Text="{Binding ReplacementReason}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" 
                        Grid.Row="4" Grid.Column="1" Margin="8,4" />

                <!-- Override Eligibility -->
                <CheckBox IsChecked="{Binding OverrideEligibility}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                         Margin="0,8" Content="Override eligibility checks" />

                <!-- Notes -->
                <TextBlock Text="Notes:" VerticalAlignment="Top" Margin="0,4" Grid.Row="6" Grid.Column="0" />
                <TextBox Text="{Binding Notes}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" 
                        Grid.Row="6" Grid.Column="1" Margin="8,4" />
            </Grid>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>