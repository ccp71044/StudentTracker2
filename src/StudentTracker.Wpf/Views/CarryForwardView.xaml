<UserControl x:Class="StudentTracker.Wpf.Views.CarryForwardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420" MinHeight="220">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />

        <TextBlock Text="Carry this unassigned placeholder to another delivery of the same course." Grid.Row="1"
                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />

        <TextBlock Text="Current delivery:" Grid.Row="2" Margin="0,4" />
        <TextBlock Text="{Binding SourceAllocation.CourseDelivery.DisplayId}" Grid.Row="3" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="Target delivery:" Grid.Row="4" VerticalAlignment="Center" Margin="0,4" />
        <ComboBox Grid.Row="5" ItemsSource="{Binding AvailableDeliveries}" SelectedItem="{Binding SelectedDelivery}"
                  DisplayMemberPath="DisplayId" VerticalAlignment="Top" Margin="0,4" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
