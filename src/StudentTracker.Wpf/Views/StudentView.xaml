<UserControl x:Class="StudentTracker.Wpf.Views.StudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="600" MinHeight="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Status:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="0" Grid.Column="0" />
            <TextBlock Text="{Binding Student.Status}" Grid.Row="0" Grid.Column="1" />
            <TextBlock Text="USI:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="0" Grid.Column="2" />
            <TextBlock Text="{Binding Student.USI}" Grid.Row="0" Grid.Column="3" />

            <TextBlock Text="Email:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="1" Grid.Column="0" />
            <TextBlock Text="{Binding Student.Email}" Grid.Row="1" Grid.Column="1" />
            <TextBlock Text="Phone:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="1" Grid.Column="2" />
            <TextBlock Text="{Binding Student.Phone}" Grid.Row="1" Grid.Column="3" />

            <TextBlock Text="Employer:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="2" Grid.Column="0" />
            <TextBlock Text="{Binding Student.Employer}" Grid.Row="2" Grid.Column="1" />
            <TextBlock Text="Work group:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="2" Grid.Column="2" />
            <TextBlock Text="{Binding Student.WorkGroup}" Grid.Row="2" Grid.Column="3" />

            <TextBlock Text="Manager:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="3" Grid.Column="0" />
            <TextBlock Text="{Binding Student.Manager}" Grid.Row="3" Grid.Column="1" />
            <TextBlock Text="Group / tag:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="3" Grid.Column="2" />
            <TextBlock Text="{Binding Student.GroupTag}" Grid.Row="3" Grid.Column="3" />

            <TextBlock Text="Emergency contact:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="4" Grid.Column="0" />
            <TextBlock Text="{Binding Student.EmergencyContact}" Grid.Row="4" Grid.Column="1" />
            <TextBlock Text="Emergency phone:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="4" Grid.Column="2" />
            <TextBlock Text="{Binding Student.EmergencyPhone}" Grid.Row="4" Grid.Column="3" />

            <TextBlock Text="Date of birth:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="5" Grid.Column="0" />
            <TextBlock Text="{Binding Student.DateOfBirth, StringFormat=dd/MM/yyyy}" Grid.Row="5" Grid.Column="1" />
            <TextBlock Text="Employee number:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="5" Grid.Column="2" />
            <TextBlock Text="{Binding Student.EmployeeNumber}" Grid.Row="5" Grid.Column="3" />

            <TextBlock Text="Notes:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="6" Grid.Column="0" />
            <TextBlock Text="{Binding Student.Notes}" TextWrapping="Wrap" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" />
        </Grid>

        <TextBlock Text="Upcoming classes" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Grid.Row="2" Margin="0,10,0,4" />
        <DataGrid ItemsSource="{Binding UpcomingClasses}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="3" Margin="0,0,0,10" Height="150">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Allocation" Binding="{Binding AllocationId}" Width="100" />
                <DataGridTextColumn Header="Course" Binding="{Binding CourseCode}" Width="150" />
                <DataGridTextColumn Header="Dates" Binding="{Binding DateRange}" Width="160" />
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="150" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Past / historical classes" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Grid.Row="4" Margin="0,10,0,4" />
        <DataGrid ItemsSource="{Binding PastClasses}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="4" Margin="0,24,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Allocation" Binding="{Binding AllocationId}" Width="100" />
                <DataGridTextColumn Header="Course" Binding="{Binding CourseCode}" Width="150" />
                <DataGridTextColumn Header="Dates" Binding="{Binding DateRange}" Width="160" />
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="150" />
                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="120" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5" Margin="0,10,0,0">
            <Button Content="Edit Student" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditStudentCommand}" />
            <Button Content="Close" Style="{StaticResource ActionButtonStyle}" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
