<UserControl x:Class="StudentTracker.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="SettingsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" AutomationProperties.AutomationId="SettingsHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Database path:" FontWeight="Bold" />
            <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" />
            <TextBlock Text="Version:" FontWeight="Bold" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Version}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button Content="Compact Database" Style="{StaticResource ActionButtonStyle}" Command="{Binding CompactDatabaseCommand}" HorizontalAlignment="Left" Width="150" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
