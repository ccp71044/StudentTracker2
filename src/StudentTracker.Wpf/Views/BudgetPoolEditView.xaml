<UserControl x:Class="StudentTracker.Wpf.Views.BudgetPoolEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="450" MinHeight="320">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,4" Grid.Row="0" Grid.Column="0" />
            <TextBox Text="{Binding Name}" Grid.Row="0" Grid.Column="1" Margin="8,4" />

            <TextBlock Text="Description:" VerticalAlignment="Center" Margin="0,4" Grid.Row="1" Grid.Column="0" />
            <TextBox Text="{Binding Description}" Grid.Row="1" Grid.Column="1" Margin="8,4" />

            <TextBlock Text="Financial period:" VerticalAlignment="Center" Margin="0,4" Grid.Row="2" Grid.Column="0" />
            <TextBox Text="{Binding FinancialPeriod}" Grid.Row="2" Grid.Column="1" Margin="8,4" />

            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,4" Grid.Row="3" Grid.Column="0" />
            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" Grid.Row="3" Grid.Column="1" Margin="8,4" VerticalContentAlignment="Center" />

            <TextBlock Text="Client name:" VerticalAlignment="Center" Margin="0,4" Grid.Row="4" Grid.Column="0" />
            <TextBox Text="{Binding ClientName}" Grid.Row="4" Grid.Column="1" Margin="8,4" />

            <TextBlock Text="Notes:" VerticalAlignment="Top" Margin="0,4" Grid.Row="5" Grid.Column="0" />
            <TextBox Text="{Binding Notes}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Grid.Row="5" Grid.Column="1" Margin="8,4" />

            <TextBlock Text="Active:" VerticalAlignment="Center" Margin="0,4" Grid.Row="6" Grid.Column="0" />
            <CheckBox IsChecked="{Binding IsActive}" Grid.Row="6" Grid.Column="1" Margin="8,4" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
