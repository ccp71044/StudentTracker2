<UserControl x:Class="StudentTracker.Wpf.Views.CourseDeliveryOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="CourseDeliveryOverviewView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Course Delivery Overview" Style="{StaticResource ViewHeaderStyle}" AutomationProperties.AutomationId="CourseDeliveryOverviewHeader" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Delivery: " FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Deliveries}" SelectedItem="{Binding SelectedDelivery}" Width="350" AutomationProperties.AutomationId="CourseDeliveryOverviewSelector">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} - {1:dd/MM/yyyy} - {2}">
                                        <Binding Path="DisplayId" />
                                        <Binding Path="StartDate" />
                                        <Binding Path="CourseDefinition.CourseTitle" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="{Binding CourseTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBlock Text="{Binding DeliveryDisplayId, StringFormat=Delivery: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

            <UniformGrid Columns="3" Margin="0,0,0,20">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="0,4,0,0" CornerRadius="4" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Capacity" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />
                        <TextBlock Text="{Binding TotalCapacity, TargetNullValue='—'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,4,0,0" CornerRadius="4" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Enrolled" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />
                        <TextBlock Text="{Binding EnrolledCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryDarkBrush}" BorderThickness="0,4,0,0" CornerRadius="4" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Spaces" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />
                        <TextBlock Text="{Binding Spaces, TargetNullValue='—'}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Enrolled Students" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <DataGrid ItemsSource="{Binding Students}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,20" AutomationProperties.AutomationId="CourseDeliveryOverviewStudentsGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Allocation" Binding="{Binding AllocationDisplayId}" Width="120" />
                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="200" />
                    <DataGridTextColumn Header="Email" Binding="{Binding StudentEmail}" Width="200" />
                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
                    <DataGridTextColumn Header="Funding" Binding="{Binding FundingSource}" Width="150" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Course Notes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBox Text="{Binding CourseNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,10" AutomationProperties.AutomationId="CourseDeliveryOverviewNotesBox" />
            <Button Content="Save Notes" Command="{Binding SaveCourseNotesCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="CourseDeliveryOverviewSaveNotesButton" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
