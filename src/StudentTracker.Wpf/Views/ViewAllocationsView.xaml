<UserControl x:Class="StudentTracker.Wpf.Views.ViewAllocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700" MinHeight="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <DataGrid ItemsSource="{Binding Allocations}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Allocation ID" Binding="{Binding DisplayId}" Width="100" />
                <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="200" />
                <DataGridTextColumn Header="Status" Binding="{Binding AllocationStatus}" Width="120" />
                <DataGridTextColumn Header="Attendance" Binding="{Binding AttendanceStatus}" Width="120" />
                <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeStatus}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Close" Style="{StaticResource ActionButtonStyle}" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
