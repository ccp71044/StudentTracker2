<UserControl x:Class="StudentTracker.Wpf.Views.DataBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800" MinHeight="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />

        <TextBlock Text="{Binding StatusText}" Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding TableNames}"
                         SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         AutomationProperties.AutomationId="DataBrowserTableList" />
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                <DataGrid ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="True"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          AutomationProperties.AutomationId="DataBrowserGrid" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add Row" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddRowCommand}" AutomationProperties.AutomationId="DataBrowserAddRowButton" />
            <Button Content="Delete Row" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeleteRowCommand}" AutomationProperties.AutomationId="DataBrowserDeleteRowButton" />
            <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveChangesCommand}" AutomationProperties.AutomationId="DataBrowserSaveButton" />
            <Button Content="Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="DataBrowserRefreshButton" />
            <Button Content="Close" Style="{StaticResource ActionButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.AutomationId="DataBrowserCloseButton" />
        </StackPanel>
    </Grid>
</UserControl>
