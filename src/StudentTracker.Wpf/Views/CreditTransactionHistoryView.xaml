<UserControl x:Class="StudentTracker.Wpf.Views.CreditTransactionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="850" MinHeight="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" Margin="0,10,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reference" Binding="{Binding Transaction.DisplayId}" Width="120" />
                <DataGridTextColumn Header="Date" Binding="{Binding Transaction.TransactionDateTime, StringFormat={}{0:g}}" Width="140" />
                <DataGridTextColumn Header="Type" Binding="{Binding Transaction.TransactionType}" Width="180" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Transaction.Amount, StringFormat=N2}" Width="120" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Transaction.Quantity, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="Reason" Binding="{Binding Transaction.Reason}" Width="220" />
                <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptDisplayName}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Open Receipt" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenReceiptCommand}" />
            <Button Content="Close" Style="{StaticResource ActionButtonStyle}" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
