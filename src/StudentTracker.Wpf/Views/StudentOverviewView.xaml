<UserControl x:Class="StudentTracker.Wpf.Views.StudentOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="StudentOverviewView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Student Overview" Style="{StaticResource ViewHeaderStyle}" AutomationProperties.AutomationId="StudentOverviewHeader" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Student: " FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" DisplayMemberPath="FullName" Width="300" AutomationProperties.AutomationId="StudentOverviewSelector" />
            </StackPanel>

            <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBlock Text="{Binding StudentDisplayId, StringFormat=ID: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20" />

            <TextBlock Text="Completed / Past Courses" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <DataGrid ItemsSource="{Binding CompletedCourses}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,20" AutomationProperties.AutomationId="StudentOverviewCompletedGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Course" Binding="{Binding CourseCode}" Width="120" />
                    <DataGridTextColumn Header="Title" Binding="{Binding CourseTitle}" Width="*" />
                    <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryDisplayId}" Width="120" />
                    <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100" />
                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100" />
                    <DataGridTextColumn Header="Funding" Binding="{Binding FundingSource}" Width="150" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Upcoming Courses" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <DataGrid ItemsSource="{Binding UpcomingCourses}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,20" AutomationProperties.AutomationId="StudentOverviewUpcomingGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Course" Binding="{Binding CourseCode}" Width="120" />
                    <DataGridTextColumn Header="Title" Binding="{Binding CourseTitle}" Width="*" />
                    <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryDisplayId}" Width="120" />
                    <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100" />
                    <DataGridTextColumn Header="Funding" Binding="{Binding FundingSource}" Width="150" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Student Notes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBox Text="{Binding StudentNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,10" AutomationProperties.AutomationId="StudentOverviewNotesBox" />
            <Button Content="Save Notes" Command="{Binding SaveNotesCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="StudentOverviewSaveNotesButton" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
