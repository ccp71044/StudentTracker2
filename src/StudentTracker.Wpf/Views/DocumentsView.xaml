<UserControl x:Class="StudentTracker.Wpf.Views.DocumentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.AutomationId="DocumentsView">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Documents" AutomationProperties.AutomationId="DocumentsHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0"/>
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1">
            <Button Content="Add Document" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddDocumentCommand}"/>
            <Button Content="View" Style="{StaticResource ActionButtonStyle}" Command="{Binding ViewDocumentCommand}"/>
            <Button Content="Edit Metadata" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditDocumentCommand}"/>
            <Button Content="Link" Style="{StaticResource ActionButtonStyle}" Command="{Binding LinkDocumentCommand}"/>
            <Button Content="Archive" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeleteDocumentCommand}"/>
            <Button Content="Restore" Style="{StaticResource ActionButtonStyle}" Command="{Binding RestoreDocumentCommand}"/>
            <Button Content="Check Missing Files" Style="{StaticResource ActionButtonStyle}" Command="{Binding CheckMissingFilesCommand}"/>
            <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived}" VerticalAlignment="Center" Margin="10,0"/>
            <ToggleButton Content="Edit Table" IsChecked="{Binding IsTableEditingEnabled}" VerticalAlignment="Center" Margin="10,0"/>
            <Button Content="Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" AutoGenerateColumns="False" Grid.Row="2" Margin="10" MouseDoubleClick="DataGrid_MouseDoubleClick" BeginningEdit="DataGrid_BeginningEdit" RowEditEnding="DataGrid_RowEditEnding">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTableEditingEnabled}" Value="True"><Setter Property="IsReadOnly" Value="False"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="View" Command="{Binding ViewDocumentCommand}"/>
                    <MenuItem Header="Edit metadata" Command="{Binding EditDocumentCommand}"/>
                    <MenuItem Header="Link to record" Command="{Binding LinkDocumentCommand}"/>
                    <Separator/>
                    <MenuItem Header="Archive" Command="{Binding DeleteDocumentCommand}"/>
                    <MenuItem Header="Restore" Command="{Binding RestoreDocumentCommand}"/>
                    <MenuItem Header="Check missing files" Command="{Binding CheckMissingFilesCommand}"/>
                    <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding DisplayId}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="250"/>
                <DataGridTextColumn Header="Original File" Binding="{Binding OriginalFileName}" Width="200" IsReadOnly="True"/><DataGridTextColumn Header="Size" Binding="{Binding FileSize}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Received" Binding="{Binding ReceivedDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Confidentiality" Binding="{Binding Confidentiality}" Width="120" IsReadOnly="True"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
