<UserControl x:Class="StudentTracker.Wpf.Views.CertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="CertificatesView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Certificate Orders" AutomationProperties.AutomationId="CertificatesHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1">
            <Button Content="New Order" Style="{StaticResource ActionButtonStyle}" Command="{Binding NewOrderCommand}" AutomationProperties.AutomationId="CertificatesNewOrderButton" ToolTip="Create a new certificate order" />
            <Button Content="Record Delivery" Style="{StaticResource ActionButtonStyle}" Command="{Binding RecordDeliveryCommand}" AutomationProperties.AutomationId="CertificatesRecordDeliveryButton" ToolTip="Record a delivery for the selected order" />
            <Button Content="Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshCertificatesButton" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" Grid.Row="2" Margin="10" IsReadOnly="True"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Show details" Command="{Binding ShowOrderDetailCommand}" AutomationProperties.AutomationId="CertificatesContextMenu_ShowDetails" />
                    <MenuItem Header="View issued certificate" Command="{Binding ViewOrderEvidenceCommand}" AutomationProperties.AutomationId="CertificatesContextMenu_ViewIssuedCertificate" />
                    <MenuItem Header="Record delivery" Command="{Binding RecordDeliveryCommand}" AutomationProperties.AutomationId="CertificatesContextMenu_RecordDelivery" />
                    <Separator />
                    <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="CertificatesContextMenu_Refresh" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order ID" Binding="{Binding DisplayId}" Width="100" />
                <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedDate, StringFormat=dd/MM/yyyy}" Width="120" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="140" />
                <DataGridTextColumn Header="Allocation" Binding="{Binding Allocation.DisplayId}" Width="110" />
                <DataGridTextColumn Header="Student" Binding="{Binding Allocation.Student.FullName}" Width="160" />
                <DataGridTextColumn Header="Course" Binding="{Binding Allocation.CourseDelivery.CourseDefinition.CourseTitle}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,4">
            <TextBlock FontWeight="Bold" Text="Delivery history" VerticalAlignment="Center" />
            <Button Content="View Evidence" Margin="12,0,0,0" Command="{Binding ViewSelectedEvidenceCommand}" />
        </StackPanel>
        <DataGrid Grid.Row="4" Margin="10" ItemsSource="{Binding DeliveryHistory}" SelectedItem="{Binding SelectedDelivery}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="View evidence" Command="{Binding ViewSelectedEvidenceCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Delivery ID" Binding="{Binding DisplayId}" Width="100" />
                <DataGridTextColumn Header="Delivered" Binding="{Binding DeliveredDate, StringFormat=dd/MM/yyyy}" Width="110" />
                <DataGridTextColumn Header="Method" Binding="{Binding DeliveryMethod}" Width="120" />
                <DataGridTextColumn Header="Delivered to" Binding="{Binding DeliveredTo}" Width="160" />
                <DataGridTextColumn Header="Recipient details" Binding="{Binding RecipientDetails}" Width="160" />
                <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceDocument.DisplayName}" Width="160" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
