<UserControl x:Class="StudentTracker.Wpf.Views.SignOffEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720" MinHeight="620">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Status -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Status: " FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LinkedDocumentInfo, StringFormat='  |  Document: {0}'}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding LinkedDocumentInfo, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                </StackPanel>

                <!-- Trainer details -->
                <TextBlock Text="Trainer Details" FontWeight="Bold" Margin="0,10,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Trainer name:" VerticalAlignment="Center" Grid.Row="0" />
                    <TextBox Text="{Binding TrainerName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="4,2"
                             IsEnabled="{Binding IsEditable}" />
                    <TextBlock Text="Business details:" VerticalAlignment="Center" Grid.Row="1" />
                    <TextBox Text="{Binding TrainerDetails, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="4,2"
                             IsEnabled="{Binding IsEditable}" />
                    <TextBlock Text="Trainer signed:" VerticalAlignment="Center" Grid.Row="2" />
                    <DatePicker SelectedDate="{Binding TrainerSignedDate}" Grid.Row="2" Grid.Column="1" Margin="4,2"
                                IsEnabled="{Binding IsEditable}" />
                </Grid>

                <!-- Authorised By -->
                <TextBlock Text="Authorised By" FontWeight="Bold" Margin="0,10,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name:" VerticalAlignment="Center" Grid.Row="0" />
                    <TextBox Text="{Binding AuthorisedByName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="4,2"
                             IsEnabled="{Binding IsEditable}" />
                    <TextBlock Text="Position:" VerticalAlignment="Center" Grid.Row="1" />
                    <TextBox Text="{Binding AuthorisedByPosition, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="4,2"
                             IsEnabled="{Binding IsEditable}" />
                    <TextBlock Text="Signed date:" VerticalAlignment="Center" Grid.Row="2" />
                    <DatePicker SelectedDate="{Binding AuthorisedSignedDate}" Grid.Row="2" Grid.Column="1" Margin="4,2"
                                IsEnabled="{Binding IsEditable}" />
                </Grid>

                <!-- Verified By -->
                <TextBlock Text="Verified By" FontWeight="Bold" Margin="0,10,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name:" VerticalAlignment="Center" Grid.Row="0" />
                    <TextBox Text="{Binding VerifiedByName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="4,2"
                             IsEnabled="{Binding IsEditable}" />
                    <TextBlock Text="Position:" VerticalAlignment="Center" Grid.Row="1" />
                    <TextBox Text="{Binding VerifiedByPosition, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="4,2"
                             IsEnabled="{Binding IsEditable}" />
                    <TextBlock Text="Signed date:" VerticalAlignment="Center" Grid.Row="2" />
                    <DatePicker SelectedDate="{Binding VerifiedSignedDate}" Grid.Row="2" Grid.Column="1" Margin="4,2"
                                IsEnabled="{Binding IsEditable}" />
                </Grid>

                <!-- Notes -->
                <TextBlock Text="Notes" FontWeight="Bold" Margin="0,10,0,4" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="50"
                         IsEnabled="{Binding IsEditable}" />

                <!-- Participants -->
                <TextBlock Text="Participants" FontWeight="Bold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Select All" Style="{StaticResource ActionButtonStyle}" Command="{Binding SelectAllCommand}"
                            IsEnabled="{Binding IsEditable}" />
                    <Button Content="Select None" Style="{StaticResource ActionButtonStyle}" Command="{Binding SelectNoneCommand}"
                            IsEnabled="{Binding IsEditable}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Allocations}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                          MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Include" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                                IsReadOnly="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <DataGridTextColumn Header="Participant" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Attendance" Binding="{Binding AttendanceText}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="110" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <WrapPanel HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Generate PDF" Style="{StaticResource ActionButtonStyle}" Command="{Binding GeneratePdfCommand}"
                    Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Import Signed PDF" Style="{StaticResource ActionButtonStyle}" Command="{Binding ImportSignedPdfCommand}"
                    Visibility="{Binding HasSignOff, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Open PDF" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenPdfCommand}"
                    Visibility="{Binding HasSignOff, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Save Details" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveDetailsCommand}"
                    Visibility="{Binding HasSignOff, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Lock as Signed" Style="{StaticResource ActionButtonStyle}" Command="{Binding LockAsSignedCommand}"
                    Visibility="{Binding HasSignOff, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelCommand}" />
        </WrapPanel>
    </Grid>
</UserControl>
