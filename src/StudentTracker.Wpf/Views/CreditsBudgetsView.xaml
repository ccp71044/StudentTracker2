<UserControl x:Class="StudentTracker.Wpf.Views.CreditsBudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="CreditsBudgetsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Credits &amp; Budgets" AutomationProperties.AutomationId="CreditsBudgetsHeader" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1">
            <Button Content="Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" />
            <Button Content="Export Position CSV" Style="{StaticResource ActionButtonStyle}" Command="{Binding ExportBudgetPositionCsvCommand}" />
            <Button Content="Add Budget Pool" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddBudgetPoolCommand}" />
            <Button Content="Edit" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditBudgetPoolCommand}" />
            <Button Content="Add Funds" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddFundsCommand}" ToolTip="Top up the selected budget pool." />
            <Button Content="Transactions" Style="{StaticResource ActionButtonStyle}" Command="{Binding BudgetTransactionHistoryCommand}" ToolTip="View the selected budget pool's transaction history." />
            <Button Content="Archive" Style="{StaticResource ActionButtonStyle}" Command="{Binding ArchiveBudgetPoolCommand}" ToolTip="Deactivate the selected budget pool." />
            <Button Content="Restore" Style="{StaticResource ActionButtonStyle}" Command="{Binding RestoreBudgetPoolCommand}" />
            <ToggleButton Content="Edit Budget Table" IsChecked="{Binding IsBudgetTableEditingEnabled}" VerticalAlignment="Center" Margin="10,0" />
            <CheckBox Content="Show inactive" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" Margin="10,0" />
        </StackPanel>
        <TabControl Grid.Row="2" Margin="10">
            <TabItem Header="Certificate Credit Pools">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
                        <Button Content="Add Credit Pool" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddCreditPoolCommand}" />
                        <Button Content="Edit" Style="{StaticResource ActionButtonStyle}" Command="{Binding EditCreditPoolCommand}" />
                        <Button Content="Add Credits" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddCreditsCommand}" ToolTip="Top up the selected credit pool." />
                        <Button Content="Transactions" Style="{StaticResource ActionButtonStyle}" Command="{Binding CreditTransactionHistoryCommand}" ToolTip="View the selected credit pool's transaction history." />
                        <Button Content="Archive" Style="{StaticResource ActionButtonStyle}" Command="{Binding ArchiveCreditPoolCommand}" ToolTip="Deactivate the selected credit pool." />
                        <Button Content="Restore" Style="{StaticResource ActionButtonStyle}" Command="{Binding RestoreCreditPoolCommand}" />
                        <ToggleButton Content="Edit Table" IsChecked="{Binding IsCreditTableEditingEnabled}" VerticalAlignment="Center" Margin="10,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding CreditPools}" SelectedItem="{Binding SelectedCreditPool}" AutoGenerateColumns="False" Grid.Row="1" Margin="10" x:Name="CreditPoolsDataGrid" BeginningEdit="CreditPoolsDataGrid_BeginningEdit" RowEditEnding="CreditPoolsDataGrid_RowEditEnding" MouseDoubleClick="CreditPoolsDataGrid_MouseDoubleClick">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="IsReadOnly" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreditTableEditingEnabled}" Value="True"><Setter Property="IsReadOnly" Value="False" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Edit" Command="{Binding EditCreditPoolCommand}" />
                                <MenuItem Header="Add Credits" Command="{Binding AddCreditsCommand}" />
                                <MenuItem Header="Transactions" Command="{Binding CreditTransactionHistoryCommand}" />
                                <MenuItem Header="Archive" Command="{Binding ArchiveCreditPoolCommand}" />
                                <MenuItem Header="Restore" Command="{Binding RestoreCreditPoolCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pool" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="150" />
                            <DataGridTextColumn Header="Unit Type" Binding="{Binding UnitType}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Width="120" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Budget Pools">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding BudgetPools}" SelectedItem="{Binding SelectedBudgetPool}" AutoGenerateColumns="False" x:Name="BudgetPoolsDataGrid" BeginningEdit="BudgetPoolsDataGrid_BeginningEdit" RowEditEnding="BudgetPoolsDataGrid_RowEditEnding" MouseDoubleClick="BudgetPoolsDataGrid_MouseDoubleClick">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="IsReadOnly" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBudgetTableEditingEnabled}" Value="True"><Setter Property="IsReadOnly" Value="False" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Edit" Command="{Binding EditBudgetPoolCommand}" />
                            <MenuItem Header="Add Funds" Command="{Binding AddFundsCommand}" />
                            <MenuItem Header="Transactions" Command="{Binding BudgetTransactionHistoryCommand}" />
                            <MenuItem Header="Archive" Command="{Binding ArchiveBudgetPoolCommand}" />
                            <MenuItem Header="Restore" Command="{Binding RestoreBudgetPoolCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pool" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Period" Binding="{Binding FinancialPeriod}" Width="120" />
                        <DataGridTextColumn Header="Funds added" Binding="{Binding FundsAdded, StringFormat=C}" Width="105" IsReadOnly="True" />
                        <DataGridTextColumn Header="Committed" Binding="{Binding Committed, StringFormat=C}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Spent" Binding="{Binding Spent, StringFormat=C}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Available" Binding="{Binding Available, StringFormat=C}" Width="105" IsReadOnly="True" />
                        <DataGridTextColumn Header="Unassigned placeholders" Binding="{Binding UnassignedPlaceholderPlaces}" Width="145" IsReadOnly="True" />
                        <DataGridTextColumn Header="Assigned pending" Binding="{Binding AssignedPendingPlaces}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Completed awaiting spend" Binding="{Binding CompletedAwaitingManualSpend}" Width="165" IsReadOnly="True" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="Completions remaining by pool and course (using current Allen cost)" FontWeight="SemiBold" Margin="0,10,0,5" />
                <DataGrid Grid.Row="2" ItemsSource="{Binding CompletionsRemaining}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pool" Binding="{Binding PoolName}" Width="160" />
                        <DataGridTextColumn Header="Course" Binding="{Binding CourseCode}" Width="120" />
                        <DataGridTextColumn Header="Title" Binding="{Binding CourseTitle}" Width="*" />
                        <DataGridTextColumn Header="Allen cost" Binding="{Binding CompletionPrice, StringFormat=C}" Width="100" />
                        <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
