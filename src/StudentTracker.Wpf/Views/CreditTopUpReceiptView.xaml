<UserControl x:Class="StudentTracker.Wpf.Views.CreditTopUpReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="450" MinHeight="420">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Amount:" VerticalAlignment="Center" Margin="0,4" Grid.Row="0" Grid.Column="0" />
            <TextBox Text="{Binding Amount}" Grid.Row="0" Grid.Column="1" Margin="8,4" Grid.ColumnSpan="2" />

            <TextBlock Text="Quantity:" VerticalAlignment="Center" Margin="0,4" Grid.Row="1" Grid.Column="0" />
            <TextBox Text="{Binding Quantity}" Grid.Row="1" Grid.Column="1" Margin="8,4" Grid.ColumnSpan="2" />

            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,4" Grid.Row="2" Grid.Column="0" />
            <DatePicker SelectedDate="{Binding TransactionDate}" Grid.Row="2" Grid.Column="1" Margin="8,4" Grid.ColumnSpan="2" />

            <TextBlock Text="Reference:" VerticalAlignment="Center" Margin="0,4" Grid.Row="3" Grid.Column="0" />
            <TextBox Text="{Binding Reference}" Grid.Row="3" Grid.Column="1" Margin="8,4" Grid.ColumnSpan="2" />

            <TextBlock Text="Reason:" VerticalAlignment="Center" Margin="0,4" Grid.Row="4" Grid.Column="0" />
            <TextBox Text="{Binding Reason}" Grid.Row="4" Grid.Column="1" Margin="8,4" Grid.ColumnSpan="2" />

            <TextBlock Text="Notes:" VerticalAlignment="Center" Margin="0,4" Grid.Row="5" Grid.Column="0" />
            <TextBox Text="{Binding Notes}" Grid.Row="5" Grid.Column="1" Margin="8,4" Grid.ColumnSpan="2" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

            <TextBlock Text="Receipt:" VerticalAlignment="Center" Margin="0,4" Grid.Row="6" Grid.Column="0" />
            <TextBlock Text="{Binding ReceiptFileName, FallbackValue='No file selected'}" VerticalAlignment="Center" Margin="8,4" Grid.Row="6" Grid.Column="1" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="2" Margin="4,0,0,0">
                <Button Content="Browse..." Style="{StaticResource ActionButtonStyle}" Command="{Binding SelectReceiptCommand}" />
                <Button Content="Clear" Style="{StaticResource ActionButtonStyle}" Command="{Binding ClearReceiptCommand}" />
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
