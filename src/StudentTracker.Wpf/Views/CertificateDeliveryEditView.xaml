<UserControl x:Class="StudentTracker.Wpf.Views.CertificateDeliveryEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="500" MinHeight="450">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource ViewHeaderStyle}" Grid.Row="0" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Order Selection -->
                <TextBlock Text="Certificate order:" VerticalAlignment="Center" Margin="0,4" Grid.Row="0" Grid.Column="0" />
                <ComboBox ItemsSource="{Binding AvailableOrders}" SelectedItem="{Binding SelectedOrder}" 
                         Grid.Row="0" Grid.Column="1" Margin="8,4" DisplayMemberPath="DisplayId" />

                <!-- Delivered Date -->
                <TextBlock Text="Delivered date:" VerticalAlignment="Center" Margin="0,4" Grid.Row="1" Grid.Column="0" />
                <DatePicker SelectedDate="{Binding DeliveredDate}" Grid.Row="1" Grid.Column="1" Margin="8,4" />

                <!-- Delivery Method -->
                <TextBlock Text="Delivery method:" VerticalAlignment="Center" Margin="0,4" Grid.Row="2" Grid.Column="0" />
                <TextBox Text="{Binding DeliveryMethod}" Grid.Row="2" Grid.Column="1" Margin="8,4" />

                <!-- Delivered To -->
                <TextBlock Text="Delivered to:" VerticalAlignment="Center" Margin="0,4" Grid.Row="3" Grid.Column="0" />
                <TextBox Text="{Binding DeliveredTo}" Grid.Row="3" Grid.Column="1" Margin="8,4" />

                <!-- Recipient Details -->
                <TextBlock Text="Recipient details:" VerticalAlignment="Center" Margin="0,4" Grid.Row="4" Grid.Column="0" />
                <TextBox Text="{Binding RecipientDetails}" Grid.Row="4" Grid.Column="1" Margin="8,4" />

                <!-- Evidence Document -->
                <TextBlock Text="Evidence document:" VerticalAlignment="Center" Margin="0,4" Grid.Row="5" Grid.Column="0" />
                <ComboBox ItemsSource="{Binding AvailableDocuments}" SelectedItem="{Binding SelectedEvidenceDocument}" 
                         Grid.Row="5" Grid.Column="1" Margin="8,4" DisplayMemberPath="DisplayName" />

                <TextBlock Text="Certificate file:" VerticalAlignment="Center" Margin="0,4" Grid.Row="6" Grid.Column="0" />
                <Grid Grid.Row="6" Grid.Column="1" Margin="8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding EvidenceFilePath}" IsReadOnly="True" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Command="{Binding SelectEvidenceFileCommand}" />
                </Grid>

                <!-- Notes -->
                <TextBlock Text="Notes:" VerticalAlignment="Top" Margin="0,4" Grid.Row="7" Grid.Column="0" />
                <TextBox Text="{Binding Notes}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" 
                        Grid.Row="7" Grid.Column="1" Margin="8,4" />
            </Grid>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Save" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>